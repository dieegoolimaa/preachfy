# Copy to .env. Never commit real values.
DATABASE_URL=mongodb://127.0.0.1:27018/preachfy?replicaSet=rs0
PORT=3001

# Login. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
# Comma-separated web origins allowed to use cookies.
ALLOWED_ORIGINS=http://localhost:8081

# Optional providers. Each one turns on when its values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_BUNDLE_ID=com.preachfy.app

# RevenueCat: secret API key and the value set as the webhook Authorization header.
REVENUECAT_SECRET_KEY=
REVENUECAT_ENTITLEMENT=preachfy_pro
REVENUECAT_WEBHOOK_AUTH=
